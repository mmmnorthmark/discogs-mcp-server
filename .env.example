# Required
DISCOGS_PERSONAL_ACCESS_TOKEN=your_personal_access_token_here

# Optional (defaults to the values below)
DISCOGS_API_URL=https://api.discogs.com
DISCOGS_MEDIA_TYPE=application/vnd.discogs.v2.discogs+json
DISCOGS_USER_AGENT=DiscogsMCPServer/<version>
PORT=3001 # SSE port
SERVER_HOST=0.0.0.0 # Server host address (0.0.0.0 allows external connections, 127.0.0.1 restricts to localhost)
SERVER_NAME="Discogs MCP Server"
READONLY_MODE=false # Set to 'true' to disable all mutating tools (create/update/delete)

# ---------------------------------------------------------------------------
# OAuth authorization server (stream transport only)
#
# This server brokers Google sign-in: it runs its own OAuth authorization
# server (dynamic client registration, PKCE S256, its own authorization
# codes) but the access_token it issues is Google's own access token, passed
# through and validated on every request via Google's tokeninfo endpoint.
#
# OAuth turns on only when all three of MCP_SERVER_URL, GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET are set. Leave them unset to run without an
# authorization server (stdio, or behind an identity gateway).
#
# Register https://<your-host>/callback as an authorized redirect URI on the
# Google OAuth client.
# ---------------------------------------------------------------------------
MCP_SERVER_URL=https://discogs.example.com/ # Public base URL; also the OAuth issuer
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Comma-separated allowlist checked on every request. Unset/empty disables the
# gate. Bypassed for requests carrying a verified identity-gateway JWT, which
# have already been gated by the gateway's own policy.
ALLOWED_GOOGLE_EMAILS=you@example.com,teammate@example.com

# ---------------------------------------------------------------------------
# Storage (OAuth client registrations + authorization codes)
#
# memory is fine for local dev. Multi-instance/autoscaled deployments need
# sqlite or firestore: /authorize, /callback and /token can otherwise land on
# different instances mid-flow and fail with invalid_grant.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=memory # memory | sqlite | firestore
STORAGE_SQLITE_PATH=./data/sessions.sqlite # sqlite backend only
FIRESTORE_PROJECT_ID=your-gcp-project-id # Required when STORAGE_BACKEND=firestore
OAUTH_CLIENTS_COLLECTION=oauth-clients # Firestore collection for registered clients
OAUTH_CODES_COLLECTION=oauth-codes # Firestore collection for authorization codes
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json # firestore auth, if not using ADC

# ---------------------------------------------------------------------------
# Identity gateway passthrough (optional)
#
# Only fires when a gateway injects a SIGNED identity JWT. Pick a preset and
# the header + verification defaults come with it; any explicit IDENTITY_* var
# below overrides the preset.
#
#   cloudflare   | gcp-iap | aws-alb | oauth2-proxy | custom (default)
#
# NOTE: the Cloudflare MCP portal does NOT forward Cf-Access-Jwt-Assertion
# upstream, so portal traffic never reaches this path. Use the email tiers
# further down for RBAC behind a portal.
# ---------------------------------------------------------------------------
# IDENTITY_PROXY=cloudflare
# CF_ACCESS_TEAM_DOMAIN=yourteam        # cloudflare preset
# CF_ACCESS_AUD=your_access_aud_tag     # cloudflare preset
# IDENTITY_AUDIENCE=                    # required for gcp-iap
# IDENTITY_AWS_REGION=eu-north-1        # aws-alb
# IDENTITY_AWS_ALB_ARN=                 # aws-alb: AWS requires verifying the signer
# TRUST_UNSIGNED_PROXY_HEADERS=false    # oauth2-proxy only; private networks only
#
# Generic/custom mode:
# IDENTITY_JWKS_URL=
# IDENTITY_ISSUER=
# IDENTITY_HEADER=cf-access-jwt-assertion
# IDENTITY_EMAIL_CLAIM=email
# IDENTITY_GROUPS_CLAIM=groups

# ---------------------------------------------------------------------------
# Per-tool RBAC (optional)
#
# Two sources, either or both. Email tiers work everywhere (including behind
# the MCP portal); group tiers need a gateway that forwards group claims.
# Matching is case-insensitive and trimmed. Highest tier wins.
#
# FAIL-CLOSED: once ANY of these six is set, an identity matching none of them
# gets no tools. Setting only the _GROUPS lists behind the MCP portal locks
# everyone out.
# ---------------------------------------------------------------------------
# IDENTITY_ROLE_ADMIN_EMAILS=you@example.com
# IDENTITY_ROLE_WRITER_EMAILS=teammate@example.com
# IDENTITY_ROLE_READER_EMAILS=guest@example.com
# IDENTITY_ROLE_ADMIN_GROUPS=Music Admin
# IDENTITY_ROLE_WRITER_GROUPS=Music Read-Write
# IDENTITY_ROLE_READER_GROUPS=Music Read-Only
